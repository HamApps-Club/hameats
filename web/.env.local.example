# PostHog analytics. Get a project API key from https://posthog.com.
# Without NEXT_PUBLIC_POSTHOG_KEY set, analytics is simply skipped.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Secret for /api/menu/status?key=..., which fetches straight from the menu source. Without it the route always 404s.
STATUS_KEY=
