# PostHog analytics. Get a project API key from https://posthog.com.
# Without NEXT_PUBLIC_POSTHOG_KEY set, analytics is simply skipped.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Secret for /api/menu/status?key=..., which fetches straight from Nutrislice. Without it the route always 404s.
STATUS_KEY=

# Neon Postgres (thumbs-ups and reviews). Vercel's Neon integration sets this for you; without it those features stay off.
DATABASE_URL=

# Log in with Google (Auth.js). AUTH_SECRET: any long random string (e.g. `npx auth secret`).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: an OAuth client from console.cloud.google.com > APIs & Services > Credentials,
# with the authorized redirect URI https://www.hameats.app/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for local dev).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional private test login: visiting /t/<this value> logs you in as test@hameats.app, with no Google. Make it long and
# random (`openssl rand -hex 24`) and keep it out of the repo. Unset, or under 24 characters, the link is switched off.
TEST_LOGIN_SECRET=

# Discord: new posts and reviews (with their photos) are sent to the channel behind NEW_POSTS_WEBHOOK_URL, each with a
# private "Remove" link. In Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Unset, they go to REPORT_WEBHOOK_URL (where reports go). MODERATION_SECRET signs the Remove links (`openssl rand -hex 32`);
# unset, AUTH_SECRET is used.
REPORT_WEBHOOK_URL=
NEW_POSTS_WEBHOOK_URL=
MODERATION_SECRET=
